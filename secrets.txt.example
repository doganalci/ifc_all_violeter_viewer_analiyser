# ============================================================
# secrets.txt — yerel sırlar (API key vb.)
# ============================================================
# Bu dosyayı KOPYALA ve repo'nun PARENT klasörüne taşı:
#
#   cp ifc_all_violeter_viewer_analiyser/secrets.txt.example ../secrets.txt
#
# Yani şu yapı oluşmalı:
#
#   ifc_claude_code_directory/
#   ├── ifc_all_violeter_viewer_analiyser/   ← repo
#   ├── secrets.txt                          ← BU DOSYA (kalıcı, repo dışı)
#   └── data/                                ← veri (kalıcı, repo dışı)
#
# Repo silinip yeniden clone'lansa bile bu dosya kaybolmaz.
# Repo içinde de okunur (geriye uyum) ama orada tutarsan re-clone'da uçar.
# ============================================================


# --- OpenAI / LLM ---
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1

# İhlal havuzu üreten LLM
LLM_MODEL=gpt-4o-mini

# IFC üreten LLM (genelde aynı tutulabilir)
IFC_LLM_MODEL=gpt-4o-mini

# RAG embedding modeli
EMBEDDING_MODEL=text-embedding-3-small


# --- Opsiyonel override'lar ---
# IFC_DATA_HOME=                              # boşsa <repo>/../data kullanılır
# IFC_SECRETS_FILE=                           # boşsa <repo>/../secrets.txt kullanılır
