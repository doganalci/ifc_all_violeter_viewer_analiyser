# ============================================================
# IFC All Violeter Viewer & Analyser — örnek .env
# ============================================================
# Bu dosyayı veri klasörüne kopyalayın:
#   cp .env.example $IFC_DATA_HOME/.env
# veya program kökünde de okunur (geriye dönük uyumluluk).
#
# Asıl yer: ~/Desktop/doga_full_ifc_prog/ifc_desktop_doc_dataset/.env

# --- VERİ KLASÖRÜ (TEK ŞART) ---------------------------------
# Tüm üretilen veri, SQLite, vektör DB, IFC'ler, model checkpointleri
# burada tutulur. Boş bırakırsanız program kardeş klasörü arar:
#   <program_root>/../ifc_desktop_doc_dataset/
# ardından ~/Desktop/doga_full_ifc_prog/ifc_desktop_doc_dataset/
IFC_DATA_HOME=

# --- LLM (OpenAI uyumlu) -------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
IFC_LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- Alt klasör override (opsiyonel) -------------------------
# Her biri set edilirse IFC_DATA_HOME altındakini geçersiz kılar.
# DATA_DIR=
# VECTORSTORE_DIR=
# DB_PATH=
# EXPORT_DIR=
# IFC_DIR=
